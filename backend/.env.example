# ShadowScan AI Backend Environment Configurations

# Port on which the express server will run
PORT=5000

# Your Google Gemini API Key. Get one at: https://aistudio.google.com/
# Never commit a real key. Leave the placeholder to run in mock mode.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Comma-separated browser origins allowed to call this API.
# In production, set this explicitly. Do not use *.
ALLOWED_ORIGINS=http://localhost:5173

# Optional. When set to production, wildcard CORS is rejected.
# NODE_ENV=production
