# ShadowScan AI Backend Environment Configurations

# Port on which the express server will run
PORT=5000

# Preferred visual provider. Get a key at https://openrouter.ai/
# Multiple keys: comma-separated. If one hits 402/429, the next key is tried.
OPENROUTER_API_KEY=sk-or-v1-key1,sk-or-v1-key2
OPENROUTER_MODEL=google/gemini-2.5-flash

# Fallback visual provider when OpenRouter is not set. Get a key at https://aistudio.google.com/
# Never commit a real key.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash

# Optional second fallback (xAI Grok)
# XAI_API_KEY=

# Comma-separated browser origins allowed to call this API.
# In production, set this explicitly to your frontend origin. Do not use *.
ALLOWED_ORIGINS=http://localhost:5173

# Optional. When set to production, only ALLOWED_ORIGINS (plus non-browser requests) are accepted.
# NODE_ENV=production
