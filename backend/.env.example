# ShadowScan AI Backend — Grok first, OpenRouter fallback

PORT=5000

# Primary: Groq vision (key starts with gsk_) — https://console.groq.com/
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.6-27b

# Fallback: OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional: xAI Grok (key must start with xai-) — https://console.x.ai/
# XAI_API_KEY=xai-your-key

# Frontend URL (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# Optional: force a specific provider (grok | openrouter | gemini)
# VISION_PROVIDER=grok

# Optional legacy fallback (only used if VISION_PROVIDER=gemini)
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# GEMINI_MODEL=gemini-2.0-flash-lite
